# Environment
APP_ENV=development
APP_NAME=DeepSight System API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Public application URLs
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:5173

# PostgreSQL is recommended. These are development-only credentials matching
# docker-compose.yml; replace them in every non-local environment.
DATABASE_URL=postgresql+psycopg://deepsight:development_password@127.0.0.1:5432/deepsight
# SQLite remains available for tests and limited offline development:
# DATABASE_URL=sqlite:///./ml7_deepsight.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_ECHO=false
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GUEST_SESSION_COOKIE_NAME=deepsight_guest_session
GUEST_SESSION_HOURS=24

# Firebase / Google identity
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=deepsight-system
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_COLLECTION=analyses
FIREBASE_ENABLED=false
FIREBASE_ADMIN_ENABLED=false
GOOGLE_CLIENT_ID=

# Inference and file storage (target configuration; not all are wired yet)
MODEL_ROOT=./deployed-models
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=uploads
REPORT_ROOT=reports
MODEL_LOADING=lazy

# Background processing
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Stripe test-mode payments; remain disabled until configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Session cookies (target configuration; current auth uses bearer tokens)
JWT_COOKIE_SECURE=false
COOKIE_DOMAIN=
