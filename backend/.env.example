APP_NAME=DeepSight System API
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO
# PostgreSQL is recommended for normal development.
DATABASE_URL=postgresql+psycopg://deepsight:development_password@127.0.0.1:5432/deepsight
# SQLite remains available for isolated tests and limited offline development:
# DATABASE_URL=sqlite:///./ml7_deepsight.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_ECHO=false
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GUEST_SESSION_COOKIE_NAME=deepsight_guest_session
GUEST_SESSION_HOURS=24

# Set these to mirror analysis records to Cloud Firestore.
FIREBASE_CREDENTIALS_PATH=C:/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_COLLECTION=analyses
FIREBASE_ENABLED=false
FIREBASE_ADMIN_ENABLED=false
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Identity Services web client ID for Google sign-in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated frontend URLs allowed to call the API.
FRONTEND_ORIGINS=http://127.0.0.1:5173,https://your-project-id.web.app,https://your-project-id.firebaseapp.com

# Models load lazily on the first inference request. Use disabled in tests.
MODEL_LOADING=lazy

# Paths relative to the backend directory.
LOCAL_STORAGE_ROOT=uploads
REPORT_ROOT=reports

# Video jobs use Redis and a separate Celery worker.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
IMAGE_MAX_SIZE_MB=10
VIDEO_MAX_SIZE_MB=100
VIDEO_MAX_DURATION_SECONDS=120
TEMPORARY_MEDIA_RETENTION_HOURS=24
VIDEO_BACKGROUND_FALLBACK_ENABLED=true
CLEANUP_SCHEDULE_ENABLED=false
CLEANUP_SCHEDULE_HOURS=6

# Stripe test mode. Keep disabled until all keys and price IDs are configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_ANNUAL=
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/subscription/success
STRIPE_CANCEL_URL=http://127.0.0.1:5173/subscription/cancel

# Deployment security
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
HTTPS_REDIRECT_ENABLED=false
RATE_LIMIT_ENABLED=true
